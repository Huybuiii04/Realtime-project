# Environment template for the Real-Time Streaming pipeline.
# Copy this file to .env and fill in the real values.
# The real .env file is gitignored and must NEVER be committed.

# --- Source Kafka (remote) ---
SOURCE_BROKERS=46.202.167.130:9094
SOURCE_SECURITY_PROTOCOL=SASL_PLAINTEXT
SOURCE_SASL_MECHANISM=PLAIN
SOURCE_SASL_USERNAME=kafka
SOURCE_SASL_PASSWORD=change_me
SOURCE_TOPIC=product_view
SOURCE_CONSUMER_GROUP_ID=source_consumer_group

# --- Destination Kafka (local cluster) ---
DESTINATION_BROKERS=localhost:9094,localhost:9194,localhost:9294
DESTINATION_SECURITY_PROTOCOL=SASL_PLAINTEXT
DESTINATION_SASL_MECHANISM=PLAIN
DESTINATION_SASL_USERNAME=kafka
DESTINATION_SASL_PASSWORD=change_me
DESTINATION_TOPIC=destination_topic

# --- App tunables ---
MAX_MESSAGES=100000
PRODUCER_BATCH_SIZE=1000
MONGO_BATCH_SIZE=5000
CONSUMER_TIMEOUT_MS=0

# --- Local Kafka client used by Kafka container ---
# Used by config/kafka/client.properties (template)
KAFKA_CLIENT_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_CLIENT_SASL_MECHANISM=PLAIN
KAFKA_CLIENT_SASL_USERNAME=kafka
KAFKA_CLIENT_SASL_PASSWORD=change_me

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=kafka_data_db
MONGO_COLLECTION=product_views_records
MONGO_URI=
MONGO_BATCH_SIZE=5000

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=postgres
POSTGRES_HOST_PORT=5433
